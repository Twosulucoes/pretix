# Copie para .env e preencha. Nunca publique o .env no GitHub.

# Senha do banco PostgreSQL (gere uma longa e aleatória).
POSTGRES_PASSWORD=troque-esta-senha

# Domínio público, sem https:// (usado pelo Caddy para emitir o certificado).
PRETIX_DOMAIN=ingressos.seudominio.com.br

# Endereço completo do sistema. Para testar no próprio computador use http://localhost:8000
PRETIX_PRETIX_URL=https://ingressos.seudominio.com.br
PRETIX_PRETIX_INSTANCE_NAME=Ingressos
PRETIX_PRETIX_CURRENCY=BRL
PRETIX_PRETIX_TRUST_X_FORWARDED_FOR=true
PRETIX_PRETIX_TRUST_X_FORWARDED_PROTO=true
# Cotação do Banco Central Europeu: desnecessária para quem vende só em reais.
PRETIX_PRETIX_ECB_RATES=false

# Idioma e fuso. O pt-br ainda é "incubating" no pretix e fica escondido sem a linha abaixo.
PRETIX_LOCALE_DEFAULT=pt-br
PRETIX_LOCALE_TIMEZONE=America/Sao_Paulo
PRETIX_LANGUAGES_ALLOW_INCUBATING=pt-br

# E-mail (SMTP) para confirmações de pedido e ingressos.
PRETIX_MAIL_FROM=ingressos@seudominio.com.br
PRETIX_MAIL_HOST=smtp.seuprovedor.com
PRETIX_MAIL_PORT=587
PRETIX_MAIL_USER=usuario-smtp
PRETIX_MAIL_PASSWORD=senha-smtp
PRETIX_MAIL_TLS=true
# Recebe os avisos de erro do sistema.
PRETIX_MAIL_ADMINS=voce@seudominio.com.br
